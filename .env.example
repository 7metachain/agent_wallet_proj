# AI Provider 选择: openai, deepseek (默认: deepseek)
AI_PROVIDER=deepseek

# DeepSeek API Key (用于 AI 意图解析)
# 获取: https://platform.deepseek.com/api_keys
# Mock 模式下可不填
DEEPSEEK_API_KEY=sk-c0f788737bc64e10a0bdfb32f63f376a

# OpenAI API Key (用于 AI 意图解析)
# 获取: https://platform.openai.com/api-keys
# Mock 模式下可不填
OPENAI_API_KEY=sk-xxxxx

# WalletConnect Project ID (用于钱包连接)
# 获取: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=xxxxx

# Mock 模式 (设为 true 可在无 API Key 情况下测试)
# NEXT_PUBLIC_MOCK_MODE=true

# Alchemy API Key (可选，用于更好的 RPC 连接)
# NEXT_PUBLIC_ALCHEMY_API_KEY=xxxxx

# ========================================
# Mock 合约地址 (部署到测试网后填入)
# ========================================
# Monad Token (Mock MON token)
NEXT_PUBLIC_MONAD_TOKEN=0x...

# Staking Pool (Yield Forwarding)
NEXT_PUBLIC_STAKING_POOL=0x...

# Mock Aave Pool (测试 supply/withdraw)
NEXT_PUBLIC_MOCK_AAVE_POOL=0x...

# Mock Swap Router (测试 swap)
NEXT_PUBLIC_MOCK_SWAP_ROUTER=0x...

# ========================================
# Hardhat Deployment (部署合约需要)
# ========================================
# 获取钱包私钥（用于部署合约，仅测试用）
PRIVATE_KEY=your_wallet_private_key_here

# RPC URL (根据要部署的网络选择)
# Monad Testnet: https://testnet-rpc.monad.xyz
# Base Sepolia: https://sepolia.base.org
# Ethereum Sepolia: https://rpc.sepolia.org
RPC_URL=https://testnet-rpc.monad.xyz
