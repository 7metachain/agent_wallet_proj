# 智谱 AI API Key (用于 AI 意图解析)
# 获取: https://open.bigmodel.cn/usercenter/apikeys
# Mock 模式下可不填
OPENAI_API_KEY=

# WalletConnect Project ID (用于钱包连接)
# 获取: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=xxxxx

# 智谱 AI 模型 (推荐使用 glm-4-plus)
# 可选: glm-4-plus, glm-4-0520, glm-4, glm-3-turbo
OPENAI_MODEL=glm-4-plus

# 智谱 AI API Base URL
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Mock 模式 (设为 true 可在无 API Key 情况下测试)
# NEXT_PUBLIC_MOCK_MODE=true

# Monad Network Configuration
# 主网 RPC: https://rpc.monad.xyz
# 测试网 RPC: https://testnet.monad.xyz
# 测试网水龙头: https://faucet.monad.xyz
